# OpenRouter (kann auch pro Anfrage aus dem Frontend per Header X-OpenRouter-Key kommen)
# Kein OPENROUTER_API_KEY hier: Anfragen laufen nur mit dem Key, den man im Interface einträgt.
# Zum Einlesen den Key nur für diesen einen Lauf mitgeben:
#   docker compose run --rm -e OPENROUTER_API_KEY=sk-or-v1-… ingest all /research --force
CHAT_MODEL=openai/gpt-6-luna
ENRICH_MODEL=openai/gpt-6-luna
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_PREFIX=rr_

# Ablage für hochgeladene Dateien
# Nur lokal ohne Docker relevant (im Container gilt /data)
DATA_DIR=./data

# Datenbanken, denen Dateien zugeordnet werden (Metadatum, filterbar im Frontend)
DATABASES=AL,CNN_DM,DL,JSW,LDK,ML,UM,EUAIA,WACHTER,OTH
# Anzeigenamen (Blumen) der Datenbanken; die Kürzel bleiben die internen Schlüssel
DATABASE_NAMES={"AL":"Aster","CNN_DM":"Camellia","DL":"Dahlia","JSW":"Jasmine","LDK":"Peony","ML":"Magnolia","UM":"Orchid","EUAIA":"EU AI Act","WACHTER":"Wachter","OTH":"Others"}

# Clustering nach jeder Ingestion (Vektoren aus Qdrant); CLUSTER_K=0 -> Anzahl automatisch
# Gesprächsgedächtnis: frühere Wechsel einer Unterhaltung gehen mit jeder Frage mit
MEMORY_MAX_TURNS=20
MEMORY_MAX_CHARS=24000
MEMORY_REWRITE=true
AUTO_CLUSTER=true
CLUSTER_K=0
# Salt für die Pokémon-Pseudonyme von Personennamen in Cluster-Bezeichnungen
PSEUDONYM_SALT=

# Ingestion
# Ordner/Dateien im research project, die nicht eingelesen werden (glob, relativ zum Projektordner, ; getrennt)
PROJECT_EXCLUDE=*Literatur*/*;**/~$*;**/.DS_Store;**/Thumbs.db
# Welche Dateien eine LLM-Zusammenfassung (Purpose, Methodology, ...) bekommen: latest | all | none
ENRICH_SCOPE=latest
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Docker Compose
# Ordner mit deinen Forschungsdaten; wird im Container read-only unter /research eingebunden
RESEARCH_DIR=./research
FRONTEND_PORT=8080
BACKEND_PORT=8000
QDRANT_PORT=6333
QDRANT_VERSION=v1.15.0
WITH_LIBREOFFICE=true

# Wissensgraph (Neo4j, ADR-001): DoCO/DEO-Ontologie für Graph RAG in Kachel B
GRAPH_ENABLED=true
NEO4J_PASSWORD=alita-neo4j
GRAPH_IMPORT_ONTOLOGIES=true   # DoCO/DEO/FaBiO/CiTO per neosemantics laden (braucht Netz)
# Textstellen ohne Überschrift per LLM einer DEO-Klasse zuordnen (Kosten: höchstens N Stellen je Dokument)
DEO_CLASSIFY=true
DEO_CLASSIFY_MAX_CHUNKS=60

# Server (Oracle Cloud + Cloudflare), siehe deploy/oracle/README.md – setup.sh trägt das ein:
# COMPOSE_FILE=docker-compose.yml:deploy/oracle/docker-compose.oracle.yml
# CLOUDFLARE_TUNNEL_TOKEN=
