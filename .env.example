# OpenRouter (can also come per request from the front end via the header X-OpenRouter-Key)
# No OPENROUTER_API_KEY here: requests only run with the key a person enters in the interface.
# For ingestion pass the key for this one run only:
#   docker compose run --rm -e OPENROUTER_API_KEY=sk-or-v1-… ingest all /research --force
CHAT_MODEL=openai/gpt-6-luna
ENRICH_MODEL=openai/gpt-6-luna
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY="" # Optional; leave empty for the local Qdrant container.
COLLECTION_PREFIX=rr_

# storage for uploaded files
# only relevant locally without Docker (in the container /data applies)
DATA_DIR=./data

# databases files are assigned to (metadata, filterable in the front end)
DATABASES=AL,CNN_DM,DL,JSW,LDK,ML,UM,EUAIA,WACHTER,OTH
# display names (flowers) of the databases; the ids stay the internal keys
DATABASE_NAMES={"AL":"Aster","CNN_DM":"Camellia","DL":"Dahlia","JSW":"Jasmine","LDK":"Peony","ML":"Magnolia","UM":"Orchid","EUAIA":"EU AI Act","WACHTER":"Wachter","OTH":"Others"}
# databases visible without the password. Colours, names and defaults: backend/app/registry.py (one place per database)
PUBLIC_DATABASES=EUAIA,WACHTER
# accounts per database (REQ-77): JSON with scrypt hashes, created with `python -m app.accounts import accounts.csv`
# (CSV: username,password). No file = no accounts. docker compose: ./.secrets/accounts/accounts.json (not in git).
# ACCOUNTS_FILE=/run/alita-accounts/accounts.json
# ACCOUNT_SESSION_SECRET=          # empty = generated once in DATA_DIR
# ACCOUNT_SESSION_HOURS=12

# clustering after every ingestion (vectors from Qdrant); CLUSTER_K=0 -> number found automatically
# conversation memory: earlier turns of a conversation go along with every question
MEMORY_MAX_TURNS=20
MEMORY_MAX_CHARS=24000
MEMORY_REWRITE=true
AUTO_CLUSTER=true
CLUSTER_K=0
# salt for the Pokémon pseudonyms of person names in cluster labels
PSEUDONYM_SALT=

# Ingestion
# folders/files in a research project that are not ingested (glob, relative to the project folder, ;-separated)
PROJECT_EXCLUDE=*Literatur*/*;**/~$*;**/.DS_Store;**/Thumbs.db
# which files get an LLM summary (Purpose, Methodology, ...): latest | all | none
ENRICH_SCOPE=latest
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Docker Compose
# folder with your research data; mounted read-only at /research in the container
RESEARCH_DIR=./research
FRONTEND_PORT=8080
BACKEND_PORT=8000
QDRANT_PORT=6333
QDRANT_VERSION=v1.15.0
WITH_LIBREOFFICE=true

# knowledge graph (Neo4j, ADR-001): DoCO/DEO ontology for Graph RAG in tile B
GRAPH_ENABLED=true
# required: set your own random password (openssl rand -hex 32).
NEO4J_PASSWORD=
GRAPH_IMPORT_ONTOLOGIES=true   # load DoCO/DEO/FaBiO/CiTO via neosemantics (needs the network)
# assign passages without a heading to a DEO class via LLM (cost: at most N passages per document)
DEO_CLASSIFY=true
DEO_CLASSIFY_MAX_CHUNKS=60

# Hetzner + Cloudflare Access: see deploy/hetzner/README.md
# COMPOSE_FILE=docker-compose.yml:deploy/hetzner/docker-compose.hetzner.yml
# optional 4 GB pilot with host swap (deploy/hetzner/operations.md):
# COMPOSE_FILE=docker-compose.yml:deploy/hetzner/docker-compose.hetzner.yml:deploy/hetzner/docker-compose.4gb.yml
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUDIENCE=             # Application Audience (AUD) tag, not a secret
# PUBLIC_ORIGIN=https://alita.example.org
# ADMIN_EMAILS=admin@example.org
# store the tunnel token separately in .secrets/cloudflare-token, NOT here.

# optional anonymous reviewer access: see deploy/hetzner/reviewers.md
# create with tools/reviewer_invites.py; never store plain-text codes in .env.
# REVIEW_ORIGIN=https://review.example.org
# REVIEW_SESSION_SECRET=
# REVIEW_INVITES={}

# server (Oracle Cloud + Cloudflare), see deploy/oracle/README.md – setup.sh fills this in:
# COMPOSE_FILE=docker-compose.yml:deploy/oracle/docker-compose.oracle.yml
# CLOUDFLARE_TUNNEL_TOKEN=
